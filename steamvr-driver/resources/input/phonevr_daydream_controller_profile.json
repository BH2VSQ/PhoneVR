{
  "jsonid": "input_profile",
  "controller_type": "phonevr_daydream_controller",
  "device_class": "TrackedDeviceClass_Controller",
  "resource_root": "phonevr",
  "driver_name": "phonevr",
  "input_bindingui_mode": "controller_handed",
  "should_show_binding_errors": true,
  "input_bindingui_left": {
    "image": "{phonevr}/icons/daydream_controller_left.svg"
  },
  "input_bindingui_right": {
    "image": "{phonevr}/icons/daydream_controller_right.svg"
  },
  "input_source": {
    "/input/joystick": {
      "type": "joystick",
      "click": true,
      "touch": true,
      "order": 1
    },
    "/input/trigger": {
      "type": "trigger",
      "click": true,
      "value": true,
      "order": 2
    },
    "/input/menu": {
      "type": "button",
      "click": true,
      "touch": false,
      "order": 3
    },
    "/input/system": {
      "type": "button",
      "click": true,
      "touch": false,
      "order": 4
    },
    "/input/volume_up": {
      "type": "button",
      "click": true,
      "touch": false,
      "order": 5
    },
    "/input/volume_down": {
      "type": "button",
      "click": true,
      "touch": false,
      "order": 6
    },
    "/pose/raw": {
      "type": "pose",
      "order": 10
    },
    "/pose/tip": {
      "type": "pose",
      "order": 11
    }
  },
  "legacy_binding": "{phonevr}/input/phonevr_daydream_legacy_bindings.json"
}
